{
  "manifest_version": 3,
  "name": "AI Chat Web Supporter",
  "version": "1.1.2",
  "description": "Practical local tools for AI chat websites: queued prompts, Claude tool auto-continue, and sidebar resizing on ChatGPT and Grok.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "action": {
    "default_title": "AI Chat Web Supporter settings",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/sidebar/core.js",
        "src/sidebar/dom.js",
        "src/sidebar/controller.js",
        "src/queue/core.js",
        "src/queue/dom.js",
        "src/providers/chatgpt.js",
        "src/providers/registry.js",
        "src/queue/scope.js",
        "src/queue/ui.js",
        "src/queue/view.js",
        "src/queue/controller.js"
      ],
      "css": ["src/sidebar/styles.css", "src/queue/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/queue/core.js",
        "src/queue/dom.js",
        "src/providers/claude.js",
        "src/providers/claude-auto-continue.js",
        "src/providers/registry.js",
        "src/queue/scope.js",
        "src/queue/ui.js",
        "src/queue/view.js",
        "src/queue/controller.js"
      ],
      "css": ["src/queue/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://grok.com/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/sidebar/core.js",
        "src/sidebar/dom.js",
        "src/sidebar/controller.js",
        "src/queue/core.js",
        "src/queue/dom.js",
        "src/providers/grok.js",
        "src/providers/registry.js",
        "src/queue/scope.js",
        "src/queue/ui.js",
        "src/queue/view.js",
        "src/queue/controller.js"
      ],
      "css": ["src/sidebar/styles.css", "src/queue/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "src/background/service-worker.js" }
}
