{
  "manifest_version": 3,
  "name": "ChatGPT Sidebar Resizer",
  "version": "1.0.0",
  "description": "Drag the ChatGPT sidebar edge to resize it and remember your preferred width.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
