{
  "manifest_version": 3,
  "name": "AI Chat Web Supporter",
  "version": "1.1.0",
  "description": "Resize the ChatGPT sidebar and queue text prompts to send automatically after each response finishes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "AI Chat Web Supporter settings",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js",
        "queue-core.js",
        "queue-dom.js",
        "queue-ui.js",
        "queue-view.js",
        "queue-content.js"
      ],
      "css": [
        "styles.css",
        "queue-content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
